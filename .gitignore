# --- PlatformIO -------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/

# --- Python -----------------------------------------------------------------
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
node_modules/

# --- Native navigation core build artefacts ---------------------------------
build/

# --- Generated experiment output --------------------------------------------
# The directories are tracked (so a fresh clone has them) but their contents are
# regenerated by every run.
logs/*
results/*
!logs/.gitkeep
!results/.gitkeep

# Hardware bench sessions are captured locally from the ESP32 serial port.
# Keep the tooling and its documentation under version control, never an
# operator's recorded runs.
hardware_logs/*
!hardware_logs/.gitkeep
!hardware_logs/README.md

# Dashboard map-editor working scene (created from scene.example.json at runtime)
config/dashboard_scene.json

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*~
*.bkp
Thumbs.db
desktop.ini
