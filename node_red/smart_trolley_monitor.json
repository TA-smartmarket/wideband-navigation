  {"id":"st_control_get","type":"http in","z":"st_flow","name":"Motor test page","url":"/smart-trolley-control","method":"get","upload":false,"swaggerDoc":"","x":150,"y":360,"wires":[["st_control_page"]]},
  {"id":"st_control_page","type":"template","z":"st_flow","name":"Render motor test page","field":"payload","fieldType":"msg","format":"handlebars","syntax":"mustache","template":"<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Smart Trolley Motor Test</title><style>body{font:16px system-ui;max-width:560px;margin:40px auto;padding:0 18px}button{font-size:20px;padding:18px;margin:8px;min-width:150px;border-radius:10px;border:0}#f{background:#16803c;color:white}#r{background:#1769aa;color:white}#s{background:#555;color:white}#e{background:#b91c1c;color:white}p{color:#555}</style></head><body><h1>Smart Trolley motor test</h1><p>Hold a direction button. Release = stop. Test with wheels raised first.</p><button id=\"f\">Forward</button><button id=\"r\">Reverse</button><button id=\"s\">STOP</button><button id=\"e\">E-STOP</button><p id=\"state\">Ready</p><script>const state=document.getElementById('state');let timer=null;async function send(action){try{await fetch('/smart-trolley-control/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action})});state.textContent=action}catch(e){state.textContent='Request failed'}}function hold(action){send(action);timer=setInterval(()=>send(action),100)}function release(){if(timer){clearInterval(timer);timer=null}send('stop')}for(const [id,a] of [['f','forward'],['r','reverse']]){const b=document.getElementById(id);b.addEventListener('pointerdown',e=>{e.preventDefault();hold(a)});for(const ev of ['pointerup','pointerleave','pointercancel'])b.addEventListener(ev,release)}document.getElementById('s').onclick=()=>release();document.getElementById('e').onclick=()=>{if(timer)clearInterval(timer);timer=null;send('estop')};</script></body></html>","output":"str","x":390,"y":360,"wires":[["st_control_page_response"]]},
  {"id":"st_control_page_response","type":"http response","z":"st_flow","name":"Serve motor test page","statusCode":"","headers":{},"x":650,"y":320,"wires":[]},
  {"id":"st_command_post","type":"http in","z":"st_flow","name":"Motor test command","url":"/smart-trolley-control/command","method":"post","upload":false,"swaggerDoc":"","x":160,"y":440,"wires":[["st_command_map"]]},
  {"id":"st_command_map","type":"function","z":"st_flow","name":"Bound web action to MQTT command","func":"const action = msg.payload && msg.payload.action;\nconst response = Object.assign({}, msg);\nlet command;\nif (action === 'forward') command = {protocol_version: 1, type: 'motor.manual', linear_mps: 0.12, angular_radps: 0};\nelse if (action === 'reverse') command = {protocol_version: 1, type: 'motor.manual', linear_mps: -0.12, angular_radps: 0};\nelse if (action === 'stop') command = {protocol_version: 1, type: 'motor.manual', linear_mps: 0, angular_radps: 0};\nelse if (action === 'estop') command = {protocol_version: 1, type: 'estop'};\nelse if (action === 'estop.reset') command = {protocol_version: 1, type: 'estop.reset'};\nelse { response.statusCode = 400; response.payload = {ok: false, error: 'unsupported action'}; return [null, response]; }\nmsg.payload = JSON.stringify(command);\nresponse.statusCode = 200;\nresponse.payload = {ok: true, action: action};\nreturn [msg, response];","outputs":2,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":430,"y":440,"wires":[["st_command_out"],["st_command_response"]]},
  {"id":"st_command_response","type":"http response","z":"st_flow","name":"Acknowledge motor test command","statusCode":"","headers":{},"x":740,"y":480,"wires":[]}
