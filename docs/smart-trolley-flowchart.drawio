        <mxCell id="estopNote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;dashed=1;fontColor=#78281F;fontSize=11;align=left;" value="EMERGENCY STOP (kapan saja)&#xa;&#xa;Dicek di awal tiap siklus update()&#xa;· motor kiri = kanan = 0 (latched)&#xa;· semua perintah ditolak&#xa;· clear_estop → IDLE (butuh &#39;start&#39; ulang)" vertex="1">
