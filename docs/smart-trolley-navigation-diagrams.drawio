        <mxCell id="safety" value="Safety invariant: motor command non-zero hanya pada state NAVIGATING.\nPosition hilang, route gagal, stop, cancel, dan E-stop selalu menghasilkan left = 0, right = 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#C0392B;fontColor=#78281F;fontStyle=1;" vertex="1" parent="1">
