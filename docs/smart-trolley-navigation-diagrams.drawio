  <diagram id="flowchart-navigation" name="Flowchart Navigasi">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ftitle" value="FLOWCHART NAVIGASI SMART TROLLEY" style="text;html=1;strokeColor=none;fillColor=none;fontSize=22;fontStyle=1;fontColor=#17202A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Mulai / Boot ESP32" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="85" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="init" value="BOOT → IDLE\nLoad graph.json + navigation.json, validasi FSM,\ninisialisasi task FreeRTOS dan motor = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2471A3;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dest" value="IDLE / WAITING_FOR_POSITION\nTaskCommands menerima destination / start / stop / replan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#8E44AD;" vertex="1" parent="1">
          <mxGeometry x="540" y="295" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pos" value="TaskPosition menerima UWB / EKF\n(x, y, quality, valid, timestamp) → latest position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;" vertex="1" parent="1">
          <mxGeometry x="540" y="405" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="Posisi valid &amp; fresh?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#B7950B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="520" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="Tolak sample\ncatat invalid / stale" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;" vertex="1" parent="1">
          <mxGeometry x="970" y="530" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="READY → PLANNING\nSnap posisi ke graph, filter obstacle,\njalankan Dijkstra, bangun waypoint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D6EAF8;strokeColor=#2471A3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="655" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="route" value="Route tersedia?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#B7950B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="770" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="error" value="ERROR\nmotor = 0\nlaporkan kegagalan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#C0392B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="970" y="780" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="navigate" value="NAVIGATING — TaskNavigation 20 Hz\nwaypoint manager → bearing &amp; heading error\nPID → v, ω → differential drive → left/right motor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#AED6F1;strokeColor=#1F618D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="910" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="arrive" value="Tujuan tercapai?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FCF3CF;strokeColor=#B7950B;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="915" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="done" value="ARRIVED\nstop motor + kirim telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F5E3;strokeColor=#27AE60;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="1030" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="monitor" value="Monitoring selama NAVIGATING:\nPOSITION_LOST: timeout posisi → motor 0\nREPLANNING: deviasi / tujuan berubah\nEMERGENCY_STOP: motor 0 (latched)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEBD0;strokeColor=#CA6F1E;" vertex="1" parent="1">
          <mxGeometry x="980" y="915" width="310" height="95" as="geometry" />
        </mxCell>
