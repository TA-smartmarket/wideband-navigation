{
  "window": {
    "width_px": 1400,
    "height_px": 850,
    "margin_px": 40,
    "panel_width_px": 380,
    "caption": "Smart Trolley - UWB + Dijkstra Navigation Simulator"
  },
  "simulation": {
    "dt_s": 0.02,
    "speed_multiplier": 1.0,
    "random_seed": 12345,
    "max_duration_s": 180.0
  },
  "uwb": {
    "update_rate_hz": 10.0,
    "noise_std_m": 0.05,
    "dropout_probability": 0.0,
    "invalid_probability": 0.0,
    "quality_base": 0.97,
    "quality_noise": 0.01,
    "quality_noise_scale": 1.5,
    "frozen_position": false,
    "filter_alpha": 1.0,
    "filter_alpha_min": 0.45,
    "filter_alpha_reference_sigma": 0.2,
    "comment": "Sensor model only. filter_alpha stands in for the EKF the UWB team runs: the positioning subsystem publishes a smoothed estimate, so navigation is not fed raw white noise. The gain adapts to noise_std_m (Kalman-like): 1.0 means no smoothing, and it falls to filter_alpha_min as the noise reaches filter_alpha_reference_sigma. The navigation side still rejects samples below navigation.json position.minimum_quality."
  },
  "physics": {
    "wheel_radius_m": 0.05,
    "wheel_base_m": 0.32,
    "max_wheel_speed_mps": 0.7,
    "motor_time_constant_s": 0.12,
    "motor_deadband_command": 0.03,
    "left_gain": 1.0,
    "right_gain": 0.97,
    "wheel_noise_std_mps": 0.0,
    "comment": "Plant model. right_gain models a small gearbox mismatch; wheel_noise_std_mps stays 0 so scenarios are exactly reproducible."
  },
  "logging": {
    "enabled": true,
    "directory": "logs",
    "results_directory": "results",
    "telemetry_rate_hz": 20.0,
    "export_csv": true,
    "export_summary": true
  },
  "render": {
    "show_graph_labels": true,
    "show_trajectory": true,
    "show_debug_overlay": true,
    "trajectory_max_points": 4000
  },
  "default_scenario": "scenario_01_basic_navigation",
  "map_path": "config/map.json",
  "graph_path": "config/graph.json",
  "navigation_config_path": "config/navigation.json",
  "benchmarks": {
    "destination_error_m": {
      "pass": 0.2,
      "warn": 0.3,
      "direction": "max"
    },
    "mean_cross_track_error_m": {
      "pass": 0.25,
      "warn": 0.4,
      "direction": "max"
    },
    "max_cross_track_error_m": {
      "pass": 0.8,
      "warn": 1.5,
      "direction": "max"
    },
    "path_efficiency_percent": {
      "pass": 90.0,
      "warn": 80.0,
      "direction": "min"
    },
    "replan_count": {
      "pass": 0,
      "warn": 2,
      "direction": "max"
    },
    "position_loss_events": {
      "pass": 0,
      "warn": 1,
      "direction": "max"
    },
    "mean_absolute_heading_error_deg": {
      "pass": 30.0,
      "warn": 45.0,
      "direction": "max"
    },
    "uwb_rmse_m": {
      "pass": 0.25,
      "warn": 0.4,
      "direction": "max"
    },
    "comment": "Acceptance bands for result validation. pass/warn are the metric limits, direction is 'max' (smaller is better) or 'min' (larger is better). A breach is reported, never treated as a run failure."
  }
}
