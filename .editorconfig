# Editor configuration: keeps the whole repository consistent.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,jsonl,ini,toml,yml,yaml}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{cpp,hpp,h,c}]
indent_size = 4
max_line_length = 120

[*.ini]
indent_style = space
indent_size = 4
